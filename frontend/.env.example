VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=plantflow
VITE_KEYCLOAK_CLIENT=plantflow-web
VITE_SHELL_ORIGIN=http://localhost:5173
VITE_TRANSPORT_REMOTE=http://localhost:5174/remoteEntry.js
VITE_FLEET_REMOTE=http://localhost:5175/remoteEntry.js
VITE_ANALYTICS_REMOTE=http://localhost:5176/remoteEntry.js
VITE_TRACKING_REMOTE=http://localhost:5177/remoteEntry.js
VITE_TRANSPORT_PUBLIC_URL=http://localhost:5174
VITE_FLEET_PUBLIC_URL=http://localhost:5175
VITE_ANALYTICS_PUBLIC_URL=http://localhost:5176
VITE_TRACKING_PUBLIC_URL=http://localhost:5177
# Use your approved map tile provider for production.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional latitude,longitude; without it the map waits for a real device position.
VITE_MAP_CENTER=

# Optional port overrides when the defaults are occupied.
VITE_SHELL_PORT=5173
VITE_TRANSPORT_PORT=5174
VITE_FLEET_PORT=5175
VITE_ANALYTICS_PORT=5176
VITE_TRACKING_PORT=5177
