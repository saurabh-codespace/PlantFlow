{
  "name": "plantflow-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:remotes && concurrently -k -n shell,transport,fleet,analytics,tracking \"npm:dev:shell\" \"npm:preview:transport\" \"npm:preview:fleet\" \"npm:preview:analytics\" \"npm:preview:tracking\"",
    "build": "npm run build:shell && npm run build:transport && npm run build:fleet && npm run build:analytics && npm run build:tracking",
    "preview": "concurrently -k -n shell,transport,fleet,analytics,tracking \"npm:preview:shell\" \"npm:preview:transport\" \"npm:preview:fleet\" \"npm:preview:analytics\" \"npm:preview:tracking\"",
    "test": "vitest run",
    "dev:shell": "vite",
    "dev:transport": "npm run build:transport && npm run preview:transport",
    "dev:fleet": "npm run build:fleet && npm run preview:fleet",
    "dev:analytics": "npm run build:analytics && npm run preview:analytics",
    "dev:tracking": "npm run build:tracking && npm run preview:tracking",
    "build:shell": "vite build",
    "build:transport": "vite build --config microfrontends/transport/vite.config.js",
    "build:fleet": "vite build --config microfrontends/fleet/vite.config.js",
    "build:analytics": "vite build --config microfrontends/analytics/vite.config.js",
    "build:tracking": "vite build --config microfrontends/tracking/vite.config.js",
    "preview:shell": "vite preview",
    "preview:transport": "vite preview --config microfrontends/transport/vite.config.js",
    "preview:fleet": "vite preview --config microfrontends/fleet/vite.config.js",
    "preview:analytics": "vite preview --config microfrontends/analytics/vite.config.js",
    "preview:tracking": "vite preview --config microfrontends/tracking/vite.config.js",
    "test:browser": "playwright test",
    "test:live": "playwright test --config playwright.live.config.js",
    "build:remotes": "npm run build:transport && npm run build:fleet && npm run build:analytics && npm run build:tracking",
    "watch:transport": "vite build --watch --config microfrontends/transport/vite.config.js",
    "watch:fleet": "vite build --watch --config microfrontends/fleet/vite.config.js",
    "watch:analytics": "vite build --watch --config microfrontends/analytics/vite.config.js",
    "watch:tracking": "vite build --watch --config microfrontends/tracking/vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "keycloak-js": "^26.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.5",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
