# Local development only. infra/start-dev.ps1 generates random values in ignored .env.
# Replace every placeholder before starting Docker Compose manually.
POSTGRES_PASSWORD=replace-with-random-postgres-admin-password
TRANSPORT_DB_PASSWORD=replace-with-random-transport-password
FLEET_DB_PASSWORD=replace-with-random-fleet-password
ANALYTICS_DB_PASSWORD=replace-with-random-analytics-password
TRACKING_DB_PASSWORD=replace-with-random-tracking-password
KEYCLOAK_DB_PASSWORD=replace-with-random-keycloak-db-password
RABBITMQ_PASSWORD=replace-with-random-rabbitmq-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-keycloak-admin-password
